{
  "expo": {
    "name": "Hypergolic",
    "slug": "hypergolic",
    "version": "0.0.0",
    "icon": "./assets/brand/app-icon.png",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "android": {
      "package": "org.nostrocket.hypergolic.dev",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon-foreground.png",
        "monochromeImage": "./assets/brand/app-icon-monochrome.png",
        "backgroundColor": "#080F17"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "org.nostrocket.hypergolic.dev",
      "icon": "./assets/brand/app-icon.png",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to approve identity backup and deletion."
      }
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "./plugins/withUnsignedRelease.cjs",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.4",
            "extraPods": [
              {
                "name": "libwebp",
                "version": "1.6.0"
              }
            ]
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "./plugins/withNativeCodecPatches.cjs",
      "./plugins/withSceneLifecycle.cjs"
    ],
    "userInterfaceStyle": "automatic"
  }
}
