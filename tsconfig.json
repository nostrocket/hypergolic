{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.ts",
    "index.signer.fixture.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/native/published-update-fixtures/**/*.tsx",
    "tests/native/feed-query/**/*.tsx",
    "tests/native/feed-subscription/**/*.tsx",
    "tests/native/upload/**/*.tsx",
    "tests/native/identity-data/**/*.tsx",
    "tests/native/links/**/*.tsx",
    "tests/native/outbox/**/*.tsx",
    "tests/native/ui-style/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
