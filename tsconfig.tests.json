{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.test.ts",
    "tests/security/**/*.test.ts",
    "tests/storage/**/*.test.ts",
    "tests/runtime/**/*.test.ts",
    "tests/network/**/*.test.ts",
    "tests/presentation/**/*.test.ts",
    "tests/outbox/**/*.test.ts"
  ]
}
