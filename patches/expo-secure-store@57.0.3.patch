+package expo.modules.securestore;
+
+/** This app keeps generic SecureStore inaccessible to identity or staging callers. */
+public final class NappletConfigPolicy {
+  public static final String SERVICE = "org.nostrocket.hypergolic.napplet-config.v1";
+  private NappletConfigPolicy() {}
+
+  public static boolean allows(String key, String service, boolean authenticated,
+      String prompt, int accessibility, String accessGroup) {
+    if (!SERVICE.equals(service) || authenticated || !" ".equals(prompt)
+        || accessibility != 6 || accessGroup != null || key == null
+        || key.length() != 70 || !key.startsWith("scope.")) return false;
+    for (int i = 6; i < key.length(); i++) {
+      char c = key.charAt(i);
+      if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+    }
+    return true;
+  }
+
+  /** Require the modern unauthenticated AES record and exact service metadata.
+   * Missing fields, coerced booleans and legacy aliases fail closed. */
+  public static boolean allowsRecord(Object scheme, Object service, Object authenticated, Object suffix) {
+    return "aes".equals(scheme) && SERVICE.equals(service)
+        && Boolean.FALSE.equals(authenticated) && Boolean.TRUE.equals(suffix);
+  }
+}
