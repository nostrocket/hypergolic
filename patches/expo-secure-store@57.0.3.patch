@@ -0,0 +1,14 @@
+import Foundation
+
+/// Restricts this app's SecureStore bridge to its existing configuration namespace.
+enum NappletConfigPolicy {
+  static let service = "org.nostrocket.hypergolic.napplet-config.v1"
+
+  static func allows(key: String, service: String?, authenticated: Bool,
+      prompt: String?, accessibility: Int, accessGroup: String?) -> Bool {
+    let bytes = Array(key.utf8)
+    guard service == self.service, !authenticated, prompt == nil, accessibility == 6,
+        accessGroup == nil, bytes.count == 70, key.hasPrefix("scope.") else { return false }
+    return bytes.dropFirst(6).allSatisfy { (48...57).contains($0) || (97...102).contains($0) }
+  }
+}
