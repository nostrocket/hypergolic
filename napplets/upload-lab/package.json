{
  "name": "@hypergolic/upload-lab-napplet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.20.0"
  },
  "napplet": {
    "dTag": "upload-lab",
    "title": "Upload Lab",
